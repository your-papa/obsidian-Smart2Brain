{
  "name": "smart-second-brain",
  "version": "0.1.0",
  "main": "main.js",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/d3-force": "^3.0.10",
    "@types/diff": "^8.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.27",
    "btca": "2.0.5",
    "builtin-modules": "^5.0.0",
    "jsdom": "^27.4.0",
    "obsidian": "^1.12.3",
    "postcss": "^8.5.8",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.5",
    "tailwindcss": "^3.4.19",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development vite build --mode development --watch",
    "build": "vite build --mode production",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "biome format --write ./src",
    "lint": "biome lint --write --unsafe ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "setup-vault": "mkdir -p 'integration/Smart2Brain Test Vault/.obsidian/plugins/smart-second-brain' && cd 'integration/Smart2Brain Test Vault/.obsidian/plugins/smart-second-brain' && ln -sf ../../../../../build/smart-second-brain/main.js main.js && ln -sf ../../../../../build/smart-second-brain/styles.css styles.css && ln -sf ../../../../../build/smart-second-brain/manifest.json manifest.json"
  },
  "type": "module",
  "dependencies": {
    "@langchain/anthropic": "^1.3.27",
    "@langchain/core": "^1.1.41",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/langgraph-checkpoint": "^1.0.1",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/ollama": "^1.2.6",
    "@langchain/openai": "^1.4.4",
    "@langchain/tavily": "^1.2.0",
    "@msgpack/msgpack": "^3.1.3",
    "@selemondev/svgl-svelte": "^0.0.3",
    "@tanstack/svelte-query": "^6.1.0",
    "bits-ui": "^2.16.3",
    "d3-force": "^3.0.0",
    "diff": "^8.0.3",
    "graphology": "^0.26.0",
    "graphology-metrics": "^2.4.0",
    "hnsw": "^1.1.1",
    "i18next": "^23.16.8",
    "langchain": "^1.3.4",
    "langsmith": "^0.5.25",
    "leiden-ts": "^0.1.0",
    "minisearch": "^7.2.0",
    "pdf-lib": "^1.17.1",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.17.1",
    "runed": "^0.37.1",
    "svelte-i18n": "^4.0.1",
    "umap-js": "^1.4.0",
    "uuid": "^11.1.0",
    "zod": "^4.3.6"
  }
}
